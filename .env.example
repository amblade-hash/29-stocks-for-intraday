# --- Telegram -------------------------------------------------------------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# The alerts channel: "Stocks to trade by Bladebot242". Another channel? Find its ID with: npm start -- --find-chat
TELEGRAM_CHAT_ID=-1003899528123
# Optional: your own chat ID for error notices (failed logins, outages). Leave empty to skip.
TELEGRAM_ADMIN_CHAT_ID=

# --- Angel One SmartAPI (read-only market data; the bot never places orders) ---
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
# Your 4-digit Angel One login PIN.
ANGEL_PIN=
# The secret behind your Angel One authenticator (TOTP) code, as shown when you enable TOTP.
ANGEL_TOTP_SECRET=

# --- Scan rules -------------------------------------------------------------
# Candles before the signal in which a PI LVLS zone bounce counts (6 = 30 minutes).
BOUNCE_LOOKBACK_CANDLES=6
# Also post WATCH (2 of 3) setups. Default: only CONFIRMED buys and sells.
ALERT_WATCH=false
# Where daily state (alerts already sent) is kept.
DATA_DIR=./data
